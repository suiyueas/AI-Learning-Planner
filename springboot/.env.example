# ============================================
# AI 学习规划师 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# 敏感信息禁止提交到代码仓库
# ============================================

# ========== AI 模型配置 ==========
# DeepSeek V4 Flash（默认工作模型）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云 Qwen-Max
QWEN_API_KEY=sk-your-qwen-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode

# 小米 MiMo-V2.5-Pro
MIMO_API_KEY=sk-your-mimo-key-here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ========== 数据库配置 ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_learning_planner
MYSQL_USERNAME=root
MYSQL_PASSWORD=your-mysql-password

# ========== Redis 配置 ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ========== 第三方服务 ==========
# Tavily 联网搜索 API Key（可选，用于 WebSearchTool）
TAVILY_API_KEY=tvly-your-tavily-key-here

# ========== JWT 安全配置 ==========
# Base64 编码的 JWT 密钥（至少 44 字符）
JWT_SECRET=your-base64-encoded-jwt-secret-key-at-least-44-chars
# Token 过期时间（秒），默认 86400 = 24 小时
JWT_EXPIRATION=86400

# ========== 应用配置 ==========
# 是否初始化默认管理员账户（admin/admin123）
# 开发环境默认开启；生产环境建议设为 false
INIT_DEFAULT_ADMIN=true