# ============================================
# AI Learning Planner - Docker Compose 环境变量模板
# 复制为 .env 并填入实际值：cp .env.example .env
# 本文件为配置模板（可提交）；.env 含敏感信息，已被 .gitignore 忽略
# 说明：不配置也可启动（中间件用演示默认值），但 AI 功能需要 API Key
# ============================================

# ========== AI 模型配置 ==========
# DeepSeek V4 Flash（默认工作模型，必填）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云 Qwen-Max（可选）
QWEN_API_KEY=sk-your-qwen-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode

# 小米 MiMo-V2.5-Pro（可选）
MIMO_API_KEY=sk-your-mimo-key-here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ========== 中间件（Docker 演示默认值，生产必改） ==========
MYSQL_DATABASE=ai_learning_planner
MYSQL_USERNAME=root
MYSQL_PASSWORD=alp-dev-2026
REDIS_PASSWORD=
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
# RAG 向量存储主存储开关（true 使用 ES，false 强制内存向量存储）
ES_VECTORSTORE_ENABLED=true

# ========== 第三方服务 ==========
# Tavily 联网搜索 API Key（可选，未配置时搜索请求失败但不影响启动）
TAVILY_API_KEY=tvly-your-tavily-key-here

# ========== JWT 安全配置 ==========
# 至少 44 字符的强密钥（生产必改）
JWT_SECRET=your-base64-encoded-jwt-secret-key-at-least-44-chars
# Token 过期时间（秒），默认 604800 = 7 天
JWT_EXPIRATION=604800

# ========== 应用配置 ==========
# 是否初始化默认管理员账户（admin/admin123），生产建议 false
INIT_DEFAULT_ADMIN=true
